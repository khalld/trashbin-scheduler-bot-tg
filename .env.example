# Copy this file to `.env` and fill in your values. The `.env` file is gitignored
# and must NEVER be committed.

# Required: Telegram bot token from @BotFather
BOT_TOKEN=

# Optional: comma-separated chat IDs that receive the daily scheduled message.
TARGET_CHAT_ID=

# Optional: comma-separated chat IDs allowed to run the /subscribers command.
ADMIN_CHAT_ID=

# Optional: "true" to send the daily message to auto-saved subscribers
# (subscribers.json) instead of TARGET_CHAT_ID.
SEND_TO_SUBSCRIBERS=false

# Optional: "true" to also append request logs to logs/requests.log.
WRITE_REQUESTS_LOG=false
